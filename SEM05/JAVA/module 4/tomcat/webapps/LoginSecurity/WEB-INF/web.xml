<?xml version="1.0" encoding="UTF-8"?>
<!-- Develop a simple login application with protected resources where only authenticated users can access a particular Servlet or page. -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">
<servlet><servlet-name>l</servlet-name><servlet-class>LoginServlet</servlet-class></servlet>
<servlet-mapping><servlet-name>l</servlet-name><url-pattern>/login</url-pattern></servlet-mapping>
<servlet><servlet-name>p</servlet-name><servlet-class>ProtectedServlet</servlet-class></servlet>
<servlet-mapping><servlet-name>p</servlet-name><url-pattern>/protected</url-pattern></servlet-mapping>
</web-app>
